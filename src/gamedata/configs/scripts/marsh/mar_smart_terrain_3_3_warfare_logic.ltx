; Warfare-spawned trader (sim_default_<faction>_trader) of whoever holds the smart.
; The trade value is replaced by the faction stock in warfare_monkeypatches configure_schemes.
[logic@mar_smart_terrain_3_3_warfare_trader]
suitable = {=check_npc_trader} true
trade = items\trade\trade_renegade.ltx
prior = 200
active = beh@mar_smart_terrain_3_3_warfare_trader
can_select_weapon = {=is_warfare} true, false
dont_keep_items = true
level_spot = trader

; Warfare-spawned mechanic, standing at the vice created by warfare_base_props.script.
[logic@mar_smart_terrain_3_3_warfare_mechanic]
suitable = {=check_npc_mechanic} true
trade = items\trade\trade_generic_mechanic.ltx
prior = 200
active = beh@mar_smart_terrain_3_3_warfare_mechanic
can_select_weapon = {=is_warfare} true, false
dont_keep_items = true
level_spot = mechanic

; Warfare-spawned barman, behind the barrel counter created by warfare_base_props.script, whose
; restrictor keeps NPCs from pathing through the barrels.
[logic@mar_smart_terrain_3_3_warfare_barman]
suitable = {=check_npc_barman} true
trade = items\trade\trade_generic_barman.ltx
prior = 200
active = beh@mar_smart_terrain_3_3_warfare_barman
can_select_weapon = {=is_warfare} true, false
dont_keep_items = true
level_spot = barman

; Warfare-spawned medic, sitting on the chair created by warfare_base_props.script. The seat is off the
; AI graph: he walks to the nearest cell (pos), and the animation is placed on the seat (animpoint).
; warfare_job_anchors keeps beh from standing him up there (its anchor seat).
[logic@mar_smart_terrain_3_3_warfare_medic]
suitable = {=check_npc_medic} true
trade = items\trade\trade_generic_medic.ltx
prior = 200
active = beh@mar_smart_terrain_3_3_warfare_medic
can_select_weapon = {=is_warfare} true, false
dont_keep_items = true
level_spot = medic

