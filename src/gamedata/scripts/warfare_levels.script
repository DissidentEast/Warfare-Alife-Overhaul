-- werejew

-- This file is used to analyze levels. In the previous version of warfare, level analysis was relatively messy.


--[[

	Factions will calculate a risk associated with levels, which will be based on how many enemy bases are present, and if their current level
	is a higher priority level for any enemy faction on neighboring levels.
	
	level_information[level].faction_stats[faction] = {
		base_count = #,
		territory_count = #,
		resource_count = #,
		linked_resource_count = #,
		total_power = #,
		faction_war = bool,
		inactive_count, -- current_action == 1
		active_count, -- current_action == 0
		
		-- the following likely isn't necessary		
		offense_squads, -- current_action = 0 and (target.props.base > 0 or target.props.resource > 0)
		patrol_squads, 	-- current_action = 0 and (target.props.base == 0 and target.props.resource == 0)
	}
	
	level_information[level].levels_by_distance = {}
	level_information[level].faction_count = #
	level_information[level].smarts = {}
	level_information[level].base_count = #
	level_information[level].territory_count = #
	level_information[level].resource_count = #
	level_information[level].lair_count = #
	level_information[level].first_update = true

]]

level_timers = {}
level_information = {}

local function level_name_for(level_id)
	local ok, name = pcall(function() return alife():level_name(level_id) end)
	return (ok and name) or "unknown"
end

-- Level links -----------------------------------------------------------------
--
-- Where offline squads can travel from a level. With CGameGraph:level_neighbours
-- (modded exes) it is the loaded game graph, cached per level for the session;
-- without it, the static level_targets.level_links that add-ons patch, read live.
-- Graph links are the edges leaving the level and may name levels warfare does not
-- admit, so consumers check level_information before indexing it.
local graph_links_available
local graph_links = {}
local no_links = {}

local function has_graph_links()
	if (graph_links_available == nil) then
		local ok, available = pcall(function()
			return (CGameGraph ~= nil) and (CGameGraph.level_neighbours ~= nil)
		end)
		graph_links_available = (ok and available) or false
		warfare_log.info("level links source: %s", graph_links_available
			and "game graph (CGameGraph:level_neighbours)" or "level_targets.level_links")
	end
	return graph_links_available
end

-- {[level_id] = true} for every level a squad can travel to from level_id; never nil.
-- Shared with the cache: callers must not modify it.
function linked_levels(level_id)
	if (level_id == nil) then
		return no_links
	end
	if not (has_graph_links()) then
		return level_targets.level_links[level_id] or no_links
	end
	local links = graph_links[level_id]
	if not (links) then
		local ok, neighbours = pcall(function() return game_graph():level_neighbours(level_id) end)
		links = (ok and (type(neighbours) == "table")) and neighbours or no_links
		graph_links[level_id] = links
	end
	return links
end

-- From the graph, a level with no outgoing edge to another level is not admitted:
-- squads could not leave it.
local function has_links(level_id)
	if (has_graph_links()) then
		return next(linked_levels(level_id)) ~= nil
	end
	return level_targets.level_links[level_id] ~= nil
end

local function link_names(set)
	local names = {}
	for lvl in pairs(set) do
		names[#names + 1] = tostring(lvl) .. ":" .. level_name_for(lvl)
	end
	table.sort(names)
	return table.concat(names, " ")
end

local function log_link_differences(level_id)
	local graph = linked_levels(level_id)
	local static = level_targets.level_links[level_id] or no_links
	local added, removed = {}, {}
	for lvl in pairs(graph) do
		if not (static[lvl]) then
			added[lvl] = true
		end
	end
	for lvl in pairs(static) do
		if not (graph[lvl]) then
			removed[lvl] = true
		end
	end
	if (next(added) ~= nil) or (next(removed) ~= nil) then
		warfare_log.info("level %s (%s) game-graph links differ from level_targets.level_links: added [%s] removed [%s]",
			tostring(level_id), level_name_for(level_id), link_names(added), link_names(removed))
	end
end

-- Level offsets ---------------------------------------------------------------
--
-- A linked level no add-on gave an offset takes one from the game graph (game point =
-- level point + level offset), in the game_levels.ltx frame that global_position's
-- hand-tuned overground values only approximate.
local function fill_offset_from_graph(level_id, vertex)
	if (global_position.level_offsets[level_id]) or not (has_links(level_id)) then
		return
	end

	local offset = vertex:game_point():sub(vertex:level_point())
	global_position.level_offsets[level_id] = { offset.x, offset.y, offset.z }
	warfare_log.info("level %s (%s) not registered by an add-on: offset (%s, %s, %s) taken from the game graph",
		tostring(level_id), level_name_for(level_id), offset.x, offset.y, offset.z)
end

-- Runs first in warfare.build_level_information, after every add-on's
-- actor_on_first_update, so an add-on's own offset is never pre-empted.
function resolve_from_game_graph()
	local gg = game_graph()
	local graph_mode = has_graph_links()
	local seen = {}
	local gvid = 0
	while gg:valid_vertex_id(gvid) do
		local vertex = gg:vertex(gvid)
		local lvl = vertex:level_id()
		if not (seen[lvl]) then
			seen[lvl] = true
			if (graph_mode) then
				log_link_differences(lvl)
			end
			fill_offset_from_graph(lvl, vertex)
		end
		gvid = gvid + 1
	end
end

-- Level admission -------------------------------------------------------------
--
-- Warfare reasons about levels through their links (linked_levels above) and
-- global_position.level_offsets (coordinates). level_information, by contrast, is
-- discovered at runtime from whatever smarts SIMBOARD reports, so a level added by
-- an add-on lands in it, gets bootstrapped,
-- owned and driven -- and then kills the process on the first lookup into a static
-- table that has never heard of it.
--
-- A level is admitted only when it has links and an offset. Objects on any other
-- level are kept out of warfare entirely; linked-level lookups still check
-- level_information (see Level links). The predicate is data-driven on purpose: a
-- level pack whose levels the game graph links (or that registers level_links,
-- without the graph export) is admitted with no change here, and the offset comes
-- from the graph when the pack registers none.
--
-- Only positive verdicts are cached. Level add-ons register their entries from their
-- own actor_on_first_update, after warfare has already asked about their levels, so a
-- negative answer is re-evaluated on every call; warfare.build_level_information
-- (actor_on_update one-shot) is where the admitted set is finally acted on.
--
-- active_levels is deliberately not part of the test. It is the aggregation roster
-- for update() below, not an eligibility list.
local level_supported = {}
local level_support_logged = {}

function is_level_supported(level_id)
	-- A nil level_id means the object's game vertex resolves to no level at all (seen
	-- on squads carrying an out-of-range m_game_vertex_id). Nothing warfare does with
	-- such an object is meaningful, so it is excluded like any other.
	if (level_id == nil) then
		if not (level_support_logged["nil"]) then
			level_support_logged["nil"] = true
			warfare_log.warn("is_level_supported: nil level_id, object excluded from warfare (reported once)")
		end
		return false
	end

	if (level_supported[level_id]) then
		return true
	end

	local linked = has_links(level_id)
	local has_offsets = (global_position.level_offsets[level_id] ~= nil)
	local supported = linked and has_offsets
	if (supported) then
		level_supported[level_id] = true
		if (level_support_logged[level_id]) then
			warfare_log.info("level %s (%s) admitted to warfare: links and level_offsets now present",
				tostring(level_id), level_name_for(level_id))
		end
	end

	if not (supported) and not (level_support_logged[level_id]) then
		level_support_logged[level_id] = true
		warfare_log.warn("level %s (%s) excluded from warfare: links=%s (%s) level_offsets=%s (reported once)",
			tostring(level_id), level_name_for(level_id),
			linked and "ok" or "missing",
			has_graph_links() and "game graph" or "level_targets.level_links",
			has_offsets and "ok" or "missing")
	end

	return supported
end

-- Resolves and caches smart.level_id as a side effect, so callers past this point
-- can rely on it being set.
function is_smart_supported(smart)
	if not (smart) then
		return false
	end
	if not (smart.level_id) then
		smart.level_id = game_graph():vertex(smart.m_game_vertex_id):level_id()
	end
	return is_level_supported(smart.level_id)
end

-- Squads change level, so nothing is cached on the object here.
function is_squad_supported(squad)
	if not (squad) then
		return false
	end
	return is_level_supported(game_graph():vertex(squad.m_game_vertex_id):level_id())
end

-- Drop-in replacement for pairs(SIMBOARD.smarts_by_names) that yields only smarts on
-- admitted levels, so the callers that walk every smart (level_information setup,
-- new-game seeding, spawn-timer stagger) keep their loop shape and pick up the filter
-- in a single line.
function supported_smarts()
	local nxt, tbl, key = pairs(SIMBOARD.smarts_by_names)
	return function()
		local smart
		repeat
			key, smart = nxt(tbl, key)
		until (key == nil) or is_smart_supported(smart)
		return key, smart
	end
end

local function in_active_levels(level_id)
	for _, lvl in pairs(level_targets.active_levels) do
		if (lvl == level_id) then
			return true
		end
	end
	return false
end

-- update() builds faction_stats only for levels on the active_levels roster, and
-- update_level reads them from linked levels, so every level with level_information
-- joins it. Vanilla's roster stops at 32 (no Meadow); add-ons may append their own.
function enroll_active_levels()
	for lvl in pairs(level_information) do
		if not (in_active_levels(lvl)) then
			table.insert(level_targets.active_levels, lvl)
			warfare_log.info("level %s (%s) added to active_levels", tostring(lvl), level_name_for(lvl))
		end
	end
end

-- active_levels is add-on writable; a level listed there without a level_information
-- entry (not admitted, or admitted with no smarts) is skipped rather than aggregated.
function update()
	warfare_log.trace("warfare_levels.update: tick start")
	for i,lvl in pairs(level_targets.active_levels) do
		if (level_information[lvl]) then
			update_level(lvl)
		end
	end
end

-- setup the faction table within level_information[level_id]["faction_stats"] and add one to the faction count
function setup_faction_table(lvl, faction)
	warfare_log.trace("setup_faction_table: lvl=%s faction=%s", tostring(lvl), tostring(faction))
	if (faction ~= "none") then
		level_information[lvl].faction_count = level_information[lvl].faction_count + 1
	end

	level_information[lvl].faction_stats[faction] = {
		base_count = 0,
		territory_count = 0,
		resource_count = 0,
		linked_resource_count = 0,
		total_power = 0,
		inactive_count = 0,
		active_count = 0,
	}
end

-- will be used by factions to determine whether or not they should find a new level to target
function faction_enemy_present(lvl, faction)
	if (faction == "none") then
		return 0, {}
	end

	local enemyCount = 0
	local enemies = {}

	for f,tbl in pairs(level_information[lvl].faction_stats) do
		if (faction ~= f) then
			if (game_relations.is_factions_enemies(faction, f)) then
				enemyCount = enemyCount + 1
				enemies[f] = true
			end
		end
	end

	warfare_log.trace("faction_enemy_present: lvl=%s faction=%s enemy_count=%s", tostring(lvl), tostring(faction), tostring(enemyCount))
	return enemyCount, enemies
end

-- Updates information for the specified level.
function update_level(lvl)
	if (not level_timers[lvl] or warfare.get_time_ref():diffSec(level_timers[lvl]) >= level_information[lvl].next_update) then
		warfare_log.trace("update_level: lvl=%s entering update branch", tostring(lvl))

		level_timers[lvl] = warfare.get_time()

		level_information[lvl].next_update = math.random(30, 120)
		
		--printf("--- updating " .. game.translate_string(alife():level_name(lvl)) .. " ---")
		
		-- TODO: store the levels information in level_information. The information will contain what factions are present and their strength.
		-- Strength will be based on the sum of all squads power. Will also store how many bases each faction owns. Resource points will be counted as well.
				
		-- clear old data; might not want to do this, as this will cause factions to re-evaluate their target level every time the current level updates.
		-- test out how this feels when playing. Worst case, set up a temporary faction_stats table, then compare the two tables and remove factions no longer in
		-- the temp faction_stats table.
		level_information[lvl].faction_stats = {}		
		level_information[lvl].faction_count = 0
		level_information[lvl].faction_war = false
		
		-- Make sure the none entry is set up.
		setup_faction_table(lvl, "none")
		
		for i,sm in pairs(level_information[lvl].smarts) do
			local smart = sm and alife_object(sm)
			
			if (smart and smart.owning_faction) then
				if not (level_information[lvl].faction_stats[smart.owning_faction]) then
					setup_faction_table(lvl, smart.owning_faction)
				end
				
				-- smart.defense_power is set by check_owner (runs lazily from
				-- smart_terrain_on_update on the alife scheduler's batch). It
				-- can be nil here for smarts that warfare bootstrapped eagerly
				-- but the scheduler hasn't ticked yet. Match the existing
				-- `or 0` idiom used at smart_terrain_warfare.script:5584/5672/5792.
				-- total_power is purely diagnostic (warfare_factions logs it but
				-- no decision reads it), so a one-tick underestimate is fine.
				local dp = smart.defense_power or 0
				if (smart.props.base > 0) then
					level_information[lvl].faction_stats[smart.owning_faction].base_count = level_information[lvl].faction_stats[smart.owning_faction].base_count + 1
					level_information[lvl].faction_stats[smart.owning_faction].total_power = level_information[lvl].faction_stats[smart.owning_faction].total_power + dp
				elseif (smart.props.territory > 0) then
					level_information[lvl].faction_stats[smart.owning_faction].territory_count = level_information[lvl].faction_stats[smart.owning_faction].territory_count + 1
					level_information[lvl].faction_stats[smart.owning_faction].total_power = level_information[lvl].faction_stats[smart.owning_faction].total_power + dp
				end

				if (smart.props.resource > 0) then
					--printf("adding one to resource for " .. alife():level_name(lvl))
					level_information[lvl].faction_stats[smart.owning_faction].resource_count = level_information[lvl].faction_stats[smart.owning_faction].resource_count + 1
					level_information[lvl].faction_stats[smart.owning_faction].total_power = level_information[lvl].faction_stats[smart.owning_faction].total_power + dp
				end
			end
		end
		
		-- avoid calculating new targets at the first update. when saving, save old targets so they persist.
		if level_information[lvl].first_update then
			warfare_log.info("update_level: lvl=%s first update, deferring target calculation", tostring(lvl))
			level_information[lvl].first_update = false

			-- Second update should happen RIGHT after first update, or some bases get stuck not finding targets for a while
			level_information[lvl].next_update = 0


        			return
		end
		
		for f,tbl in pairs(level_information[lvl].faction_stats) do
			if f ~= "none" then
				for lvl2,_ in pairs(linked_levels(lvl)) do
					if (level_information[lvl2] and level_information[lvl2].faction_stats and level_information[lvl2].faction_stats[f]) then
						--printf("!!! adding " .. level_information[lvl2].faction_stats[f].resource_count .. " to linked resources")
						level_information[lvl].faction_stats[f].linked_resource_count = level_information[lvl].faction_stats[f].linked_resource_count + level_information[lvl2].faction_stats[f].resource_count
					end
				end
				
				if level_information[lvl].faction_count == 1 then
					level_information[lvl].faction_stats[f].faction_war = false
				else				
					local enemyCount = faction_enemy_present(lvl, f)
					level_information[lvl].faction_stats[f].faction_war = (enemyCount > 0)
				end
			end
		end
	end

end
