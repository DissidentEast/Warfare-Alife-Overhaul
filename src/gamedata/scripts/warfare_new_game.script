--[[
=======================================================================================
    Warfare new-game start for the psi-off factions (Monolith, Sin, Zombified).

    Vanilla's new-game setup (ui_mm_faction_select.on_game_load) switches off the Miracle
    Machine, the Brain Scorcher and the generators for these factions. Warfare keeps them
    running and hands the player a good psy helmet instead.

    Vanilla's callbacks are local functions, so they cannot be wrapped, and callbacks run
    in no fixed order (axr_main keeps them in a hash set). So this reads the chosen faction
    once at game start, before any on_game_load can clear it from the config, and applies
    the changes on the actor's first update, after vanilla's setup has finished.
=======================================================================================
--]]

local PSI_OFF = { monolith = true, greh = true, zombied = true }

-- The infos vanilla gives a psi-off faction on a story-mode start.
local STORY_DEVICE_INFOS = {
    "yan_labx16_switcher_1_off",
    "yan_labx16_switcher_2_off",
    "yan_labx16_switcher_3_off",
    "yan_labx16_switcher_primary_off",
    "bar_deactivate_radar_done",
    "warlab_deactivate_generators_done",
}

local pending -- { faction = string, story = bool } for a new game that picked a psi-off faction

local function actor_on_first_update()
    UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)

    local choice = pending
    pending = nil
    if not (choice and db.actor) then
        return
    end

    -- Same test vanilla uses to decide that this new game is a Warfare one.
    if not alife_storage_manager.get_state().enable_warfare_mode then
        return
    end

    if choice.story and not has_alife_info("story_mode_disabled") then
        warfare_log.info("warfare_new_game: %s start, keeping the story-flag devices running", choice.faction)
        for _, info in ipairs(STORY_DEVICE_INFOS) do
            disable_info(info)
        end
    end

    warfare_log.info("warfare_new_game: giving a psy helmet to a %s start", choice.faction)
    alife_create_item("good_psy_helmet", db.actor)
end

function on_game_start()
    pending = nil

    local config = axr_main.config
    if not config then
        return
    end

    local faction = config:r_value("character_creation", "new_game_faction", 3) or ""
    if not PSI_OFF[faction] then
        return
    end

    pending = {
        faction = faction,
        story = config:r_value("character_creation", "new_game_story_mode", 1) == true,
    }
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
